<Window x:Class="SchedulerUI.MainWindow"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SchedulerUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Имя клиента:"/>
            <TextBox x:Name="ClientNameTextBox" Margin="0,5,0,15"/>

            <TextBlock Text="Услуга:"/>
            <ComboBox x:Name="ServiceComboBox" IsEditable="True" Margin="0,5,0,15"/>

            <TextBlock Text="Длительность (мин):"/>
            <ComboBox x:Name="DurationComboBox" IsEditable="True" Margin="0,5,0,15"/>

            <TextBlock Text="Цена:"/>
            <ComboBox x:Name="PriceComboBox" IsEditable="True" Margin="0,5,0,15"/>

            <Label Content="Выберите дату:"/>
            <DatePicker x:Name="AppointmentDatePicker" DisplayDateStart="{x:Static sys:DateTime.Now}"/>

            <Label Content="Выберите время:"/>
            <ComboBox x:Name="AppointmentTimeComboBox" Margin="0,5" SelectedIndex="0">
                <ComboBoxItem Content="09:00"/>
                <ComboBoxItem Content="09:30"/>
                <ComboBoxItem Content="10:00"/>
                <ComboBoxItem Content="10:30"/>
                <ComboBoxItem Content="11:00"/>
                <ComboBoxItem Content="11:30"/>
                <ComboBoxItem Content="12:00"/>
                <ComboBoxItem Content="12:30"/>
                <ComboBoxItem Content="13:00"/>
                <ComboBoxItem Content="13:30"/>
                <ComboBoxItem Content="14:00"/>
                <ComboBoxItem Content="14:30"/>
                <ComboBoxItem Content="15:00"/>
                <ComboBoxItem Content="15:30"/>
                <ComboBoxItem Content="16:00"/>
                <ComboBoxItem Content="16:30"/>
                <ComboBoxItem Content="17:00"/>
                <ComboBoxItem Content="17:30"/>
                <ComboBoxItem Content="18:00"/>
            </ComboBox>

            <Button Content="Записать клиента" Width="200" Height="40" Click="RecordClient_Click"/>
        </StackPanel>

        <DataGrid x:Name="AppointmentsDataGrid" Grid.Row="1" Margin="0,20,0,0" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Клиент" Binding="{Binding Client.Name}" Width="120"/>
                <DataGridTextColumn Header="Услуга" Binding="{Binding Service.ServiceName}" Width="120"/>
                <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="140"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
